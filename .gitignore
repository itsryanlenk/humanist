# The calibration config is generated from YOUR OWN writing and is nobody else's
# business. It records the filenames it measured. Never commit it.
humanist.config.json
superhumanizer.config.json

# Calibration corpora: your unpublished drafts do not belong in a shared repo.
corpus/
my-writing/

# Eval and sweep artefacts (regenerated by the harness, large, and often contain
# draft prose that was never meant to ship).
evals/runs/
evals/out/
sweep/

__pycache__/
*.py[cod]
.venv/
venv/
node_modules/

.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Personal terms for the privacy gate: usernames, handles, and the names of
# unrelated private projects. NEVER commit this. A denylist of the things you
# want kept private is itself a disclosure of them.
.privacy-terms
